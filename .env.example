# Copy to .env and fill in. Never commit .env.

# Required. Get one at https://platform.claude.com/ (API keys).
ANTHROPIC_API_KEY=

# Models (defaults shown)
DESK_MODEL=claude-opus-5-5
TA_DEEP_MODEL=claude-opus-5-5
TA_QUICK_MODEL=claude-sonnet-5-5

# Token meter: the daily budget the meter fills up against (input + output tokens)
DAILY_TOKEN_BUDGET=1000000

# Optional: Telegram. Token comes from @BotFather. Chat id is your own numeric id;
# only messages from this chat are obeyed. Leave blank to turn Telegram off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: free key from fred.stlouisfed.org, used by TradingAgents' macro data
FRED_API_KEY=
